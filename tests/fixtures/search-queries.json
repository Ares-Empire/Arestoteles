     "want": [{"note": "Gutenberg Bible", "has": "180 copies"}]},
    {"q": "In how many towns were there presses fifty years after Gutenberg?", "lang": "en", "kind": "figure",
     "want": [{"note": "Printing press", "has": "250 European towns"}]},
