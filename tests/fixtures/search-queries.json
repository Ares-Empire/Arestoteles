     "want": [{"note": "Printing press", "has": "250 European towns"}]},
    {"q": "Wann bekam Venedig seine erste Druckerpresse?", "lang": "de", "kind": "figure",
     "want": [{"note": "Spread of print", "has": "Venice · 1469"}]},
    {"q": "When did the Reformation end?", "lang": "en", "kind": "figure",
     "want": [{"note": "Reformation", "has": "Peace of Westphalia"}]},
