{
  "about": "Queries for the made-up fixture vault (the vault behind docs/samples), used by scripts/search_eval.py to compare meaning models. Each names the passages that answer it: the note and words of the passage's plain text. An empty `want` is a query the vault cannot answer (it sets how similar a passage must be to count).",
  "queries": [
    {"q": "How many copies of the Gutenberg Bible were made?", "lang": "en", "kind": "figure",
     "want": [{"note": "Gutenberg Bible", "has": "180 copies"}]},
