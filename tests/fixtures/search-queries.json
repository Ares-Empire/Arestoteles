              {"note": "Printing press", "has": "reprinted whatever sold"}]},
    {"q": "Warum haben die Drucker Luther gedruckt?", "lang": "de", "kind": "other words",
     "want": [{"note": "Information wants to be cheap", "has": "because Luther sold"},
              {"note": "Printing press", "has": "they printed what sold"},
              {"note": "Printing press", "has": "reprinted whatever sold"}]},
    {"q": "Where did the early printers settle?", "lang": "en", "kind": "other words",
     "want": [{"note": "Spread of print", "has": "Printers went where"}]},
    {"q": "Wohin zogen die Buchdrucker?", "lang": "de", "kind": "other words",
