    {"q": "Pettegree book about Luther", "lang": "en", "kind": "source",
     "want": [{"note": "Printing press", "has": "Brand Luther"}]},
    {"q": "Handelsstadt", "lang": "de", "kind": "term",
     "want": [{"note": "Spread of print", "has": "trading cities"}]},
    {"q": "Druckort", "lang": "de", "kind": "term",
     "want": [{"note": "Printing press", "has": "Druckorte"}]},
    {"q": "Westfälischer Frieden", "lang": "de", "kind": "term",
