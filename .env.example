# The website's settings: copy to .env (git-ignored, chmod 600 on the server). Secrets live ONLY there.
# Read by the compose `web` container and the quotes timer. The vault service does not read this file
# (its optional settings go in vault.env, see deploy/README.md).

# Login gate of arestoteles.de (webauth/server.py). Make the hash with webauth/gen_password.py;
# it is ':'-delimited because docker compose interpolates '$' in env files.
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
# Hand-off tokens from the Ares Empire hub (shared with the hub)
SSO_SECRET=

# Alpaca PAPER keys, read-only market data for web/live.json (scripts/refresh_quotes.py)
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
