# Copy to .env (gitignored, chmod 600 on the server). Secrets live ONLY here.
# The AI never sees these values; only the Python execution/ingest layer does.

# Postgres (docker compose service name "db")
DATABASE_URL=postgresql+psycopg://arestoteles:arestoteles@db:5432/arestoteles

# Alpaca PAPER keys (Phase 1+). Live keys must not exist anywhere until Phase 5.
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=

# Telegram notifications + approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude API (Phase 2+)
ANTHROPIC_API_KEY=

# Aresium read-only API bearer token (Phase 4)
ARESIUM_API_TOKEN=

# SEC EDGAR fair-use policy requires a descriptive User-Agent with contact info
EDGAR_USER_AGENT=Arestoteles/0.1 (you@example.com)
